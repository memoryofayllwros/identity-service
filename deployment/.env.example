# Pacific Identity Platform — deployment env template
APP_ENV=dev
SERVICE_NAME=identity

MONGODB_URI=mongodb://localhost:27017
IDENTITY_DATABASE_NAME=identity_db

# Immutable single-tenant binding for this VM
TENANT_INSTANCE_ID=pacific-medical
DEPLOYMENT_ID=local-dev-001

SECRET_KEY=change-me
REFRESH_SECRET_KEY=change-me-too
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=10080
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

DOMAIN=localhost
FRONTEND_PUBLIC_URL=http://localhost:3000
